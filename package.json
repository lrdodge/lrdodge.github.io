{
  "name": "luke-dodge-thoughts",
  "private": true,
  "description": "Luke Dodge's writing on engineering, leadership, and building great teams",
  "version": "0.1.0",
  "author": "Luke Dodge <luke.r.dodge@gmail.com>",
  "bugs": {
    "url": "https://github.com/lrdodge/lrdodge.github.io/issues"
  },
  "dependencies": {
    "@lekoarts/gatsby-theme-minimal-blog": "^6.2.6",
    "gatsby": "^5.16.1",
    "gatsby-plugin-feed": "^5.16.0",
    "gatsby-plugin-google-gtag": "^5.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "decode-uri-component": "file:compat/decode-uri-component",
    "theme-ui": "~0.15.3"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.10"
  },
  "homepage": " https://lrdodge.github.io/",
  "keywords": [
    "gatsby"
  ],
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lrdodge/lrdodge.github.io.git"
  },
  "scripts": {
    "build": "GATSBY_TELEMETRY_DISABLED=1 GATSBY_FEEDBACK_DISABLED=1 gatsby build",
    "develop": "GATSBY_TELEMETRY_DISABLED=1 GATSBY_FEEDBACK_DISABLED=1 gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "start": "GATSBY_TELEMETRY_DISABLED=1 GATSBY_FEEDBACK_DISABLED=1 gatsby develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "node scripts/check-decoder.cjs && npm run build && node scripts/check-build.cjs",
    "deploy": "gatsby build && gh-pages -d public -b site && git push",
    "help": "gh-pages --help"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "immutable": "^3.8.4",
    "cookie": "^0.7.2",
    "tmp": "^0.2.7",
    "webpack": "^5.112.2",
    "serialize-javascript": "^7.1.4",
    "sharp": "^0.35.5",
    "path-to-regexp": "0.1.13",
    "@graphql-tools/utils": "^13.2.1",
    "uuid": "^11.1.1",
    "webpack-dev-middleware": "^7.4.6",
    "decode-uri-component": "$decode-uri-component"
  }
